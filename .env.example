# WARDEN — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# OpenAI-compatible gateway URL
INNOTEL_GATEWAY_URL=https://gateway.innotel.us/v1

# Gateway key; kept in the OS keychain, never in the repo
INNOTEL_GATEWAY_KEY=

# Default model id
GENIE_MODEL=auto/best-chat

# Chromium binary to drive (empty = bundled Electron)
CHROME_PATH=

# DevTools port for Scry and smoke checks
CHROME_CDP_PORT=9222

# Verbose Scry logging
WARDEN_SCRY_DEBUG=0

# Optional Cerulean issuer for deployed services
CERULEAN_OIDC_ISSUER=https://auth.cerulean.innotel.us/application/o/ontrak/
