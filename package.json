{
  "name": "warden",
  "productName": "WARDEN",
  "version": "0.2.20",
  "description": "Privacy-first operations browser for security and network administrators",
  "author": "WARDEN",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dist": "node scripts/smoke-packaged.mjs",
    "verify:remote": "node scripts/remote-check.mjs",
    "icon": "node scripts/make-icon.mjs",
    "check:pty": "node scripts/check-pty.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "hooks": "node scripts/install-hooks.mjs --strict",
    "prepare": "node scripts/install-hooks.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:release": "npm run build && electron-builder --win --publish always",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "dist:ci": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "node-pty": true
  }
}
