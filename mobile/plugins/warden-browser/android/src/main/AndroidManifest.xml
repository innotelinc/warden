<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          The browser surface is its own activity rather than a view inside the
          Capacitor web view: a page has to be rendered by the platform engine, and
          putting a second WebView under the shell's own would leave the shell
          receiving the touches meant for the page.

          Theme is a platform one, not the app's AppCompat theme: this activity is
          a plain Activity with platform widgets, so it needs no AppCompat delegate.
        -->
        <activity
            android:name=".WardenBrowserActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|locale"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="WARDEN Mobile"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
