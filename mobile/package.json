{
  "name": "warden-mobile",
  "private": true,
  "version": "0.2.17",
  "description": "WARDEN for Android and iOS — store-ready Capacitor shell",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/status-bar": "^7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "warden-browser": "file:./plugins/warden-browser"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.5"
  }
}
